# Copy this file to .env and fill in your values.
# The Go server reads this automatically on startup via godotenv.

# Google Sheets spreadsheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Port for the Go HTTP server (default: 8080)
# PORT=8080

# ── Google OAuth (optional — auth is disabled if these are absent) ─────────────

# OAuth 2.0 Client ID from Google Cloud Console (Web application type).
# Authorised JavaScript origins must include http://localhost:8080 (dev)
# and your production domain.
GOOGLE_CLIENT_ID=

# Random string used to HMAC-sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Comma-separated list of Google account emails allowed to sign in.
# Uploaded Drive files are shared with these emails as readers.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# ── Document upload & AI parsing (optional) ────────────────────────────────────

# Anthropic API key — enables PDF/image parsing for FD, insurance, and metals.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Directory containing extraction prompts (fd.md, insurance.md, metals.md).
# Defaults to ./prompts relative to the binary — edit the .md files to tune
# what Claude extracts without touching code.
# PROMPTS_DIR=prompts
