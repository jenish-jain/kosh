# Copy this file to .env and fill in your values.
# The Go server reads this automatically on startup via godotenv.

# Google Sheets spreadsheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Port for the Go HTTP server (default: 8080)
# PORT=8080

# ── Google OAuth (optional — auth is disabled if these are absent) ─────────────

# OAuth 2.0 Client ID from Google Cloud Console (Web application type).
# Authorised JavaScript origins must include http://localhost:8080 (dev)
# and your production domain.
GOOGLE_CLIENT_ID=

# Random string used to HMAC-sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Comma-separated list of Google account emails allowed to sign in.
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# ── Document upload & AI parsing (optional) ────────────────────────────────────

# Anthropic API key — enables PDF/image parsing for FD, insurance, and metals.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Directory containing extraction prompts (fd.md, insurance.md, metals.md).
# Defaults to ./prompts relative to the binary — edit the .md files to tune
# what Claude extracts without touching code.
# PROMPTS_DIR=prompts

# ── AI Financial Advisor — Ask Kosh (optional) ─────────────────────────────────

# Set to "true" to enable the Ask Kosh chat panel. Disabled by default.
# When enabled, an "Ask Kosh" button appears in the sidebar; the AI answers
# questions using the user's live financial data as context.
# AI_ENABLED=false

# Which AI provider to use. Options: "ollama" (default, free, local) or "anthropic".
#
#   ollama    — runs on your machine, no data leaves your network, no cost.
#               Install: brew install ollama && ollama serve
#               Pull a model: ollama pull llama3.1
#
#   anthropic — uses Claude Haiku via API (~₹0.04/question). Requires
#               ANTHROPIC_API_KEY above.
#
# AI_PROVIDER=ollama

# Ollama: URL of the running Ollama instance (default: http://localhost:11434).
# Change this if Ollama runs on a different host or port.
# OLLAMA_URL=http://localhost:11434

# Ollama: which model to use (default: llama3.1).
# Other good options: mistral, gemma2, phi3
# OLLAMA_MODEL=llama3.1
